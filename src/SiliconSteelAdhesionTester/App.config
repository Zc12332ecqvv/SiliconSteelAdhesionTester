<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <startup useLegacyV2RuntimeActivationPolicy="true">
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <add key="PlcMode" value="Simulation" />
    <add key="PlcIp" value="192.168.3.2" />
    <add key="PlcPort" value="502" />
    <add key="PlcRack" value="0" />
    <add key="PlcSlot" value="1" />
    <add key="PollIntervalMs" value="250" />
    <add key="CommandPulseMs" value="300" />
    <add key="DuplicateQrCodeSeconds" value="30" />
    <add key="QrCodeScannerEnabled" value="true" />
    <!-- SR-1000最终采用TCP/IP；键盘输入仅保留为调试兼容入口。 -->
    <add key="QrCodeInputTimeoutMs" value="120" />
    <add key="QrCodeMinimumLength" value="4" />
    <add key="OrientedScannerIp" value="192.168.3.11" />
    <add key="OrientedScannerPort" value="9004" />
    <add key="NonOrientedScannerIp" value="192.168.3.12" />
    <add key="NonOrientedScannerPort" value="9004" />
    <add key="ScannerConnectTimeoutMs" value="3000" />
    <add key="ScannerReadTimeoutMs" value="5000" />
    <add key="ScannerTriggerCommand" value="" />
    <add key="ScannerStopCommand" value="" />
    <add key="ScannerTerminator" value="CR" />
    <add key="AutomaticDeviceInteractionsEnabled" value="true" />
    <!-- 相机或视觉软件按以下子目录落图：oriented\before、oriented\after、non-oriented\tape。 -->
    <add key="CameraInputDirectory" value="CameraInput" />
    <add key="CameraProvider" value="Folder" />
    <add key="CameraIp" value="" />
    <add key="OrientedCameraIp" value="" />
    <add key="NonOrientedCameraIp" value="" />
    <add key="CameraCaptureTimeoutMs" value="10000" />
    <add key="CameraFileStableMs" value="300" />
    <!-- 脱落率单位为百分比；投产前必须用标准样件重新标定阈值。 -->
    <add key="OrientedMaxLossRate" value="3.0" />
    <add key="NonOrientedMaxLossRate" value="3.0" />
    <add key="VisionDifferenceThreshold" value="28" />
    <add key="VisionMinimumParticleArea" value="20" />
    <add key="VisionOutputDirectory" value="images" />
  </appSettings>
</configuration>
